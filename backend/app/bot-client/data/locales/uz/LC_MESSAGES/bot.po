#: app/handlers/users/lang.py:20
msgid "welcome_message"
msgstr "<tg-emoji emoji-id=\"5371073319107827779\">🙂</tg-emoji> Assalomu alaykum!\n\n<tg-emoji emoji-id=\"5361600266225326825\">✈️</tg-emoji> Aviachipta xarid qilmoqchi bo'lsangiz, \n<tg-emoji emoji-id=\"5391032818111363540\">📍</tg-emoji> Qayerdan qayerga kerakligini,\n<tg-emoji emoji-id=\"5431897022456145283\">📆</tg-emoji> Borish va qaytib kelish sanalarini,\n<tg-emoji emoji-id=\"5458382591121964689\">✍️</tg-emoji> Aniqroq yozib yuborsangiz,\n<tg-emoji emoji-id=\"5190498849440931467\">👨‍💻</tg-emoji> Hodimlarimiz tezda ko'rib, batafsil javob berishadi!"

