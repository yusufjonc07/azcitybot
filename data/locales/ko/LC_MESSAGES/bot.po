#: app/commands/default.py:8
msgid "start chat"
msgstr "채팅 시작"

#: app/commands/default.py:9
msgid "change language"
msgstr "언어 변경"

#: app/handlers/admins/claim.py:18
msgid "You are not an admin."
msgstr "관리자가 아닙니다."

#: app/handlers/admins/claim.py:25
msgid "No group connected to your admin account."
msgstr "관리자 계정에 연결된 그룹이 없습니다."

#: app/handlers/admins/claim.py:56
msgid "Chat not found or already claimed."
msgstr "채팅을 찾을 수 없거나 이미 점유되었습니다."

#: app/handlers/admins/claim.py:96
msgid "You have claimed this chat."
msgstr "이 채팅을 점유했습니다."

#: app/handlers/admins/join.py:14
msgid "This command can only be used in groups."
msgstr "이 명령어는 그룹에서만 사용할 수 있습니다."

#: app/handlers/admins/join.py:19
msgid "Usage: /admin @username"
msgstr "사용법: /admin @사용자명"

#: app/handlers/admins/notify.py:20
msgid "Enter message text:"
msgstr "메시지 텍스트를 입력하세요:"

#: app/handlers/users/chat.py:15
msgid "A support agent will reach out to you soon."
msgstr "👨‍💻 잠시만 기다려 주시기 바랍니다. \n 곧 저희 직원이 연락드리겠습니다."

#: app/handlers/users/chat.py:136
msgid "Chat cancelled."
msgstr "채팅이 취소되었습니다."

#: app/handlers/users/chat.py:170
msgid "Talk ended"
msgstr "대화 종료"

#: app/handlers/users/lang.py:14
msgid "Select language:"
msgstr "언어를 선택하세요:"

#: app/handlers/users/lang.py:20
msgid "welcome_message"
msgstr "<tg-emoji emoji-id=\"5371073319107827779\">🙂</tg-emoji> 안녕하세요!\n\n<tg-emoji emoji-id=\"5361600266225326825\">✈️</tg-emoji> 항공권을 구매하고 싶으시면, \n<tg-emoji emoji-id=\"5391032818111363540\">📍</tg-emoji> 어디에서 어디로 필요한지,\n<tg-emoji emoji-id=\"5431032818111363540\">📆</tg-emoji> 가는 날과 돌아오는 날을,\n<tg-emoji emoji-id=\"5458382591121964689\">✍️</tg-emoji> 자세히 적어 보내주시면,\n<tg-emoji emoji-id=\"5190498849440931467\">👨‍💻</tg-emoji> 저희 직원들이 빠르게 확인하고 상세히 답변드립니다!"

#: app/keyboards/chat.py:23
msgid "🙌 End Chat"
msgstr "🙌 채팅 종료"

#: app/keyboards/chat.py:35
msgid "🙅‍♂️ Cancel Chat"
msgstr "🙅‍♂️ 채팅 취소"

#: app/keyboards/chat.py:47
msgid "☑️ Claim Chat"
msgstr "☑️ 채팅 점유"